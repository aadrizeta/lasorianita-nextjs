{
  "info": {
    "name": "La Sorianita · CMS Directus",
    "description": "Llamadas que la web de La Sorianita (Next.js) hace al CMS Directus en `{{base_url}}`.\n\n- Acceso **sólo lectura** con el rol público: no se envía token.\n- Todo cuelga de `/items/<colección>` y la respuesta siempre viene envuelta en `{ data }`.\n- El código equivalente está en `src/lib/directus.ts` (transporte) y `src/lib/catalogo.ts` (consultas y normalización).\n- Next cachea estas respuestas 300 s (tag `catalogo`).\n\nLas peticiones con tabla tienen la pestaña **Visualize** en la respuesta.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 · Estado del CMS",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/server/ping",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "server",
                "ping"
              ]
            },
            "description": "Comprueba que la instancia de Directus está levantada. Debe devolver `pong`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve pong', () => pm.expect(pm.response.text()).to.include('pong'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 · Llamadas que hace la web",
      "description": "Exactamente las consultas de `src/lib/catalogo.ts`. Con estas cuatro se pinta todo el sitio.",
      "item": [
        {
          "name": "Categorías publicadas  · getCategorias()",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/items/categorias?filter[status][_eq]=published&sort=sort&limit=-1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "items",
                "categorias"
              ],
              "query": [
                {
                  "key": "filter[status][_eq]",
                  "value": "published",
                  "description": "Sólo publicadas"
                },
                {
                  "key": "sort",
                  "value": "sort",
                  "description": "Orden definido en el CMS"
                },
                {
                  "key": "limit",
                  "value": "-1",
                  "description": "Sin paginación"
                }
              ]
            },
            "description": "Usada en el menú, la portada y `/catalogo`. Guarda el primer slug en `categoria_slug`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Directus envuelve la respuesta en { data }', () => pm.expect(json).to.have.property('data'));",
                  "pm.test('Hay categorías', () => pm.expect(json.data.length).to.be.above(0));",
                  "if (json.data[0]) pm.environment.set('categoria_slug', json.data[0].slug);",
                  "const filas = Array.isArray(json.data) ? json.data : [json.data];",
                  "const columnas = [\"id\",\"sort\",\"nombre\",\"slug\",\"color_acento\",\"icono\"];",
                  "const get = (o, ruta) => ruta.split('.').reduce((a, k) => (a == null ? a : a[k]), o);",
                  "const celda = (v) => Array.isArray(v) ? v.map((x) => x?.alergenos_id?.codigo ?? JSON.stringify(x)).join(', ') : (v ?? '—');",
                  "const html = `<style>body{font-family:sans-serif;font-size:13px}table{border-collapse:collapse;width:100%}th,td{border:1px solid #ddd;padding:6px 8px;text-align:left}th{background:#f4ece1}</style>",
                  "<p><b>${filas.length}</b> registros</p><table><tr>${columnas.map((c) => `<th>${c}</th>`).join('')}</tr>",
                  "${filas.map((f) => `<tr>${columnas.map((c) => `<td>${celda(get(f, c))}</td>`).join('')}</tr>`).join('')}</table>`;",
                  "pm.visualizer.set(html);"
                ]
              }
            }
          ]
        },
        {
          "name": "Catálogo completo · getProductos()",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/items/productos?filter[status][_eq]=published&sort=categoria.sort,sort&limit=-1&fields=id,status,sort,nombre,slug,descripcion_corta,precio_orientativo,unidad_precio,formato,peso_aprox_g,destacado,vegano,imagen,date_created,date_updated,categoria.nombre,categoria.slug,alergenos.alergenos_id.codigo,trazas.alergenos_id.codigo",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "items",
                "productos"
              ],
              "query": [
                {
                  "key": "filter[status][_eq]",
                  "value": "published",
                  "description": "El rol público NO filtra borradores: hay que pedirlo explícitamente"
                },
                {
                  "key": "sort",
                  "value": "categoria.sort,sort",
                  "description": "Por categoría y luego por orden interno"
                },
                {
                  "key": "limit",
                  "value": "-1",
                  "description": "Sin paginación"
                },
                {
                  "key": "fields",
                  "value": "id,status,sort,nombre,slug,descripcion_corta,precio_orientativo,unidad_precio,formato,peso_aprox_g,destacado,vegano,imagen,date_created,date_updated,categoria.nombre,categoria.slug,alergenos.alergenos_id.codigo,trazas.alergenos_id.codigo",
                  "description": "Sólo lo que necesita la rejilla; relaciones expandidas con notación de punto"
                }
              ]
            },
            "description": "Se pide **una vez** y la web filtra en memoria: productos por categoría, destacados y relacionados salen de aquí.\n\nPeculiaridades de la respuesta cruda (normalizadas en `catalogo.ts`):\n- `precio_orientativo` llega como string (`\"4.50\"`).\n- `destacado` / `vegano` llegan como `0 | 1`.\n- `alergenos` llega con doble salto por la tabla puente: `[{ alergenos_id: { codigo } }]`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Directus envuelve la respuesta en { data }', () => pm.expect(json).to.have.property('data'));",
                  "const p = json.data[0];",
                  "pm.test('Precio llega como string (se convierte en catalogo.ts)', () => { if (p && p.precio_orientativo != null) pm.expect(p.precio_orientativo).to.be.a('string'); });",
                  "pm.test('Booleanos llegan como 0/1', () => { if (p) pm.expect([0, 1, true, false, null]).to.include(p.destacado); });",
                  "pm.test('Categoría expandida (nombre + slug)', () => { if (p) pm.expect(p.categoria).to.have.keys('nombre', 'slug'); });",
                  "if (p) pm.environment.set('producto_slug', p.slug);",
                  "const filas = Array.isArray(json.data) ? json.data : [json.data];",
                  "const columnas = [\"nombre\",\"categoria.nombre\",\"precio_orientativo\",\"unidad_precio\",\"destacado\",\"vegano\",\"alergenos\"];",
                  "const get = (o, ruta) => ruta.split('.').reduce((a, k) => (a == null ? a : a[k]), o);",
                  "const celda = (v) => Array.isArray(v) ? v.map((x) => x?.alergenos_id?.codigo ?? JSON.stringify(x)).join(', ') : (v ?? '—');",
                  "const html = `<style>body{font-family:sans-serif;font-size:13px}table{border-collapse:collapse;width:100%}th,td{border:1px solid #ddd;padding:6px 8px;text-align:left}th{background:#f4ece1}</style>",
                  "<p><b>${filas.length}</b> registros</p><table><tr>${columnas.map((c) => `<th>${c}</th>`).join('')}</tr>",
                  "${filas.map((f) => `<tr>${columnas.map((c) => `<td>${celda(get(f, c))}</td>`).join('')}</tr>`).join('')}</table>`;",
                  "pm.visualizer.set(html);"
                ]
              }
            }
          ]
        },
